{
  "name": "api-workbench",
  "displayName": "API Workbench",
  "description": "CipherDeck API Workbench inside VS Code. Requests run from the extension host, so there is no CORS.",
  "version": "1.0.1",
  "publisher": "SurajPrasad1993",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SurajPrasadd/apiworkbench.git"
  },
  "categories": [
    "Other",
    "Testing"
  ],
  "icon": "icon.ico",
  "keywords": [
    "api",
    "api client",
    "api testing",
    "http",
    "https",
    "rest",
    "rest api",
    "http client",
    "request",
    "response",
    "rest client",
    "postman",
    "collections",
    "environment",
    "variables",
    "api development",
    "developer tools",
    "json",
    "headers",
    "query params",
    "pre-request",
    "post-response",
    "javascript",
    "cryptojs",
    "aes",
    "encryption",
    "decryption",
    "jwt",
    "authentication",
    "bearer token",
    "access token",
    "refresh token",
    "cors",
    "local",
    "offline",
    "request history",
    "saved responses"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "apiWorkbench.open",
        "title": "API Workbench: Open"
      },
      {
        "command": "apiWorkbench.revealDataFile",
        "title": "API Workbench: Reveal Data File"
      }
    ],
    "configuration": {
      "title": "API Workbench",
      "properties": {
        "apiWorkbench.allowInsecureTls": {
          "type": "boolean",
          "default": false,
          "description": "Accept self-signed HTTPS certificates (for local https:// servers only)."
        },
        "apiWorkbench.dataFilePath": {
          "type": "string",
          "default": "",
          "description": "Where collections, environments, history and settings are saved. Leave empty to use the extension's global storage folder. Supports an absolute path, ~/path, or a path relative to the first workspace folder."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  }
}

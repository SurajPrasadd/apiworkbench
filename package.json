{
  "name": "api-workbench",
  "displayName": "API Workbench",
  "description": "CipherDeck API Workbench inside VS Code. Requests run from the extension host, so there is no CORS.",
  "version": "1.0.6",
  "publisher": "SurajPrasad1993",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SurajPrasadd/apiworkbench.git"
  },
  "categories": [
    "Other",
    "Testing"
  ],
  "icon": "icon.ico",
  "keywords": [
    "api", "api client", "api testing", "http", "https", "rest", "rest api",
    "http client", "request", "response", "rest client", "postman",
    "collections", "environment", "variables", "api development",
    "developer tools", "json", "headers", "query params", "pre-request",
    "post-response", "javascript", "cryptojs", "aes", "encryption",
    "decryption", "jwt", "authentication", "bearer token", "access token",
    "refresh token", "cors", "local", "offline", "request history",
    "saved responses"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:apiWorkbench.open",
    "onCommand:apiWorkbench.revealDataFile",
    "onView:apiWorkbench.launcher"
  ],
  "contributes": {
    "commands": [
      {
        "command": "apiWorkbench.open",
        "title": "API Workbench: Open"
      },
      {
        "command": "apiWorkbench.revealDataFile",
        "title": "API Workbench: Reveal Data File"
      }
    ],
    "configuration": {
      "title": "API Workbench",
      "properties": {
        "apiWorkbench.allowInsecureTls": {
          "type": "boolean",
          "default": false,
          "description": "Accept self-signed HTTPS certificates (for local https:// servers only)."
        },
        "apiWorkbench.dataFilePath": {
          "type": "string",
          "default": "",
          "description": "Where collections, environments, history and settings are saved. Leave empty to use the extension's global storage folder. Supports an absolute path, ~/path, or a path relative to the first workspace folder."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apiWorkbenchContainer",
          "title": "API Workbench",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "apiWorkbenchContainer": [
        {
          "id": "apiWorkbench.launcher",
          "name": "API Workbench",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "apiWorkbench.launcher",
        "contents": "Build, send and organise API requests.\n[Open API Workbench](command:apiWorkbench.open)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "typecheck": "tsc -p ./ --noEmit",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:bufferutil --external:utf-8-validate --format=cjs --platform=node --target=node16 --minify",
    "bundle:dev": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:bufferutil --external:utf-8-validate --format=cjs --platform=node --target=node16 --sourcemap",
    "watch": "npm run bundle:dev -- --watch"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}